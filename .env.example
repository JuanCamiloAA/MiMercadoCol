APP_NAME="MiMercadoCol"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=canasta_pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@lacanasta.co"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Importacion de articulos desde Open Food Facts (catalogo externo).
# El User-Agent es obligatorio y debe llevar un contacto real: sin el, la API bloquea.
CATALOG_OFF_BASE_URL=https://world.openfoodfacts.org
CATALOG_OFF_USER_AGENT="miMercadoCol/1.0 (contacto@lacanasta.co)"
CATALOG_OFF_TIMEOUT=15
CATALOG_OFF_DELAY_MS=1000
CATALOG_IMPORT_QUEUE=imports
CATALOG_IMPORT_CSV_MAX_KB=20480

# Servidor de sockets (Laravel Reverb). `php artisan reverb:start` lo levanta.
REVERB_APP_ID=lacanasta
REVERB_APP_KEY=reverb-key-local
REVERB_APP_SECRET=reverb-secret-local
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Lo que ve el navegador. En produccion, detras del proxy: el dominio y 443/https.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
